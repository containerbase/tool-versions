{
  "name": "tool-versions",
  "private": true,
  "description": "Versions of the tools containerbase install-tool supports",
  "license": "MIT",
  "author": "Michael Kriese <michael.kriese@mend.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/containerbase/tool-versions.git"
  },
  "type": "module",
  "scripts": {
    "build": "node src/index.ts",
    "lint": "run-s oxfmt oxlint lint:types",
    "lint:types": "tsc",
    "lint-fix": "run-s oxfmt-fix oxlint-fix",
    "oxfmt": "oxfmt --check",
    "oxfmt-fix": "oxfmt",
    "oxlint": "oxlint",
    "oxlint-fix": "oxlint --fix",
    "pack:release": "node src/pack.ts",
    "release-notes": "node src/notes.ts",
    "prepare": "husky",
    "test": "vitest run"
  },
  "dependencies": {
    "@containerbase/base": "14.57.3",
    "@nodable/flexible-xml-parser": "1.11.3",
    "@renovatebot/pep440": "5.0.1",
    "@renovatebot/ruby-semver": "5.0.0",
    "renovate": "44.186.0",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@containerbase/oxlint-plugin": "1.0.3",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nock": "15.0.5",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.16.0"
}
